# Newsletter Configuration

# OpenAI API Key (required for use of openai proprietary models)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URI to the OLLAMA server - required for use of open-weights models via ollama
# The default assumes ollama server running on the same machine.
OLLAMA_BASE_URL=http://localhost:11434/v1

# alternatively for ollama cloud:
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=...

# Number of days to look back for recent items (default: 7)
CUTOFF_DAYS=7

# Minimum expected items (warns if fewer, default: 3)
MIN_ITEMS=3

# Maximum expected items (warns if more, default: 30)
MAX_ITEMS=30

# Source URI for the dataset (default: Hugging Face ZenML LLMOps dataset)
SOURCE_URI=hf://datasets/zenml/llmops-database/data/train-00000-of-00001.parquet

# Scoring Agent Configuration

# Model to use for relevance scoring (default: openai:gpt-4o-mini)
SCORING_MODEL=openai:gpt-4o-mini


# Model to use for dynamic categorisation (default: openai:gpt-4o-mini)
CATEGORY_MODEL=openai:gpt-4o-mini


# Path to audience profile file (default: data/audience_profile.txt)
AUDIENCE_PROFILE_PATH=data/audience_profile.txt
